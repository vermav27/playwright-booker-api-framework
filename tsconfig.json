{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "schemas/**/*.ts", "test-data/**/*.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
